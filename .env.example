# Server-only values for Vercel Functions. Never add the SUPABASE service role key
# or LINE channel access token with a VITE_ prefix.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LINE Login channel ID (the numeric part before the LIFF app suffix)
LINE_CHANNEL_ID=2011792268
ADMIN_LINE_USER_ID=your-approved-line-user-id

# Optional LINE Messaging API alert destination. No broadcast is used.
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token
LINE_TARGET_ID=your-approved-group-or-user-id

# Optional independent HMAC secret for request rate-limit fingerprints
RATE_LIMIT_SECRET=generate-a-long-random-secret
